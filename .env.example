# ───────────────────────── Model server (AWS GGUF server) ─────────────────────────
NEXT_PUBLIC_ZIK_API=https://api.zikriyonai.linkpc.net
# direct = browser -> model server (needs ALLOWED_ORIGINS on the server to include this site, key is public)
# proxy  = browser -> /api/chat -> model server (key stays secret on the server; needs a host without short timeouts)
NEXT_PUBLIC_CHAT_MODE=direct
# direct mode: same value as the server's ZIK_API_KEY (it is visible in the browser — only a speed bump)
NEXT_PUBLIC_ZIK_API_KEY=
# proxy mode (server-only, NOT exposed to the browser)
ZIK_API_KEY=

# ───────────────────────── Firebase Admin (server routes: payments, admin, referral) ─────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=zikriyon-ai
FIREBASE_CLIENT_EMAIL=
# keep the \n sequences; wrap in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma separated Google-verified emails allowed into /admin (approve UPI payments, students)
ADMIN_EMAILS=you@example.com

# Dev only: simulate a purchase with no real money (ignored in production builds)
NEXT_PUBLIC_PAYMENT_SANDBOX=false

# ───────────────────────── Receiving UPI account ─────────────────────────
# The UPI ID (VPA) money is paid to — e.g. your Google Pay / Bank of Baroda VPA
UPI_VPA=zikreameen@okhdfcbank
# Secret used by the phone that forwards bank SMS to /api/payments/webhook (min 16 chars, long random string)
PAYMENT_WEBHOOK_SECRET=
